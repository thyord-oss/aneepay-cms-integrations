{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <span class="label {{ mode_class }}">{{ mode_label }}</span> &middot; {{ payment_aneepay_token|upper }} &middot;
        {% if sandbox %}amoy{% else %}{{ payment_aneepay_network }}{% endif %}
        &middot; <span class="label {{ payment_aneepay_status == '1' ? 'label-success' : 'label-default' }}">{{ payment_aneepay_status == '1' ? text_enabled : text_disabled }}</span>
      </div>
    </div>

    {% if quick_setup %}
    <div class="panel panel-warning">
      <div class="panel-heading"><h3 class="panel-title">{{ text_quick_setup }}</h3></div>
      <div class="panel-body">
        <ol>
          <li>{{ text_quick_setup_1 }}</li>
          <li>{{ text_quick_setup_2 }}</li>
          <li>{{ text_quick_setup_3 }}</li>
          <li>{{ text_quick_setup_4 }}</li>
        </ol>
        <p><strong>{{ text_endpoint }}</strong></p>
        <p><strong>{{ text_status_url }}</strong><br>{{ status_url }}</p>
        <p><strong>{{ text_success_url }}</strong><br>{{ success_url }}</p>
        <p><strong>{{ text_fail_url }}</strong><br>{{ fail_url }}</p>
        <p><strong>{{ text_cron_hint }}</strong><br>{{ cron_url }}</p>
      </div>
    </div>
    {% endif %}

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_general }}</h3></div>
        <div class="panel-body">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_status" id="input-status" class="form-control">
                {% if payment_aneepay_status == '1' %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-title">{{ entry_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_aneepay_title" value="{{ payment_aneepay_title }}" placeholder="{{ entry_title }}" id="input-title" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-description">{{ entry_description }}</label>
            <div class="col-sm-10">
              <textarea name="payment_aneepay_description" rows="3" id="input-description" class="form-control">{{ payment_aneepay_description }}</textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_connection }}</h3></div>
        <div class="panel-body">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-account-id">{{ entry_account_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_aneepay_account_id" value="{{ payment_aneepay_account_id }}" placeholder="00000000-0000-0000-0000-000000000000" id="input-account-id" class="form-control" />
              {% if error_account_id %}<div class="text-danger">{{ error_account_id }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-webhook-secret">{{ entry_webhook_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_aneepay_webhook_secret" value="" placeholder="{{ webhook_secret }}" id="input-webhook-secret" class="form-control" />
              {% if error_webhook_secret %}<div class="text-danger">{{ error_webhook_secret }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-site-domain">{{ entry_site_domain }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_aneepay_site_domain" value="{{ payment_aneepay_site_domain }}" placeholder="{{ entry_site_domain }}" id="input-site-domain" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-test-mode">{{ entry_test_mode }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_test_mode" id="input-test-mode" class="form-control">
                {% if payment_aneepay_test_mode == '1' %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2">
              <button type="button" id="aneepay-test-connection" class="btn btn-default" data-url="{{ test_url }}">{{ button_test }}</button>
              <span id="aneepay-test-result"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_coin }}</h3></div>
        <div class="panel-body">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-token">{{ entry_token }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_token" id="input-token" class="form-control">
                {% for value, label in token_options %}
                {% if payment_aneepay_token == value %}
                <option value="{{ value }}" selected="selected">{{ label }}</option>
                {% else %}
                <option value="{{ value }}">{{ label }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-network">{{ entry_network }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_network" id="input-network" class="form-control">
                {% for value, label in network_options %}
                {% if payment_aneepay_network == value %}
                <option value="{{ value }}" selected="selected">{{ label }}</option>
                {% else %}
                <option value="{{ value }}">{{ label }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-rate-source">{{ entry_rate_source }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_rate_source" id="input-rate-source" class="form-control">
                {% for value, label in rate_source_options %}
                {% if payment_aneepay_rate_source == value %}
                <option value="{{ value }}" selected="selected">{{ label }}</option>
                {% else %}
                <option value="{{ value }}">{{ label }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-exchange-rate">{{ entry_exchange_rate }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_aneepay_exchange_rate" value="{{ payment_aneepay_exchange_rate }}" id="input-exchange-rate" class="form-control" step="0.000001" />
              {% if error_exchange_rate %}<div class="text-danger">{{ error_exchange_rate }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-fee-rule">{{ entry_fee_rule }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_fee_rule" id="input-fee-rule" class="form-control">
                {% for value, label in fee_options %}
                {% if payment_aneepay_fee_rule == value %}
                <option value="{{ value }}" selected="selected">{{ label }}</option>
                {% else %}
                <option value="{{ value }}">{{ label }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_statuses }}</h3></div>
        <div class="panel-body">
          {% set status_fields = {
            'pending_status_id': entry_pending_status,
            'paid_status_id': entry_paid_status,
            'failed_status_id': entry_failed_status,
            'cancelled_status_id': entry_cancelled_status
          } %}
          {% for field, label in status_fields %}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-{{ field }}">{{ label }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_{{ field }}" id="input-{{ field }}" class="form-control">
                {% for status in order_statuses %}
                {% if attribute(_context, 'payment_aneepay_' ~ field) == status.order_status_id %}
                <option value="{{ status.order_status_id }}" selected="selected">{{ status.name }}</option>
                {% else %}
                <option value="{{ status.order_status_id }}">{{ status.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_advanced }}</h3></div>
        <div class="panel-body">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-cron">{{ entry_cron_interval }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_cron_interval" id="input-cron" class="form-control">
                {% for value, label in cron_options %}
                {% if payment_aneepay_cron_interval == value %}
                <option value="{{ value }}" selected="selected">{{ label }}</option>
                {% else %}
                <option value="{{ value }}">{{ label }}</option>
                {% endif %}
                {% endfor %}
              </select>
              <div class="help-block">{{ cron_url }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-debug">{{ entry_debug }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_debug" id="input-debug" class="form-control">
                {% if payment_aneepay_debug == '1' %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-keep-data">{{ entry_keep_data }}</label>
            <div class="col-sm-10">
              <select name="payment_aneepay_keep_data" id="input-keep-data" class="form-control">
                {% if payment_aneepay_keep_data == '1' %}
                <option value="1" selected="selected">{{ text_keep_data }}</option>
                <option value="0">{{ text_delete_data }}</option>
                {% else %}
                <option value="1">{{ text_keep_data }}</option>
                <option value="0" selected="selected">{{ text_delete_data }}</option>
                {% endif %}
              </select>
              <div class="help-block">{{ help_keep_data }}</div>
            </div>
          </div>

          <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2">
              <button type="button" id="aneepay-toggle-logs" class="btn btn-default" data-url="{{ logs_url }}">{{ button_logs }}</button>
              <button type="button" id="aneepay-clear-logs" class="btn btn-default" style="display:none;" data-url="{{ clear_url }}">{{ button_clear }}</button>
              <span id="aneepay-log-count"></span>
              <div id="aneepay-log-panel" style="display:none;margin-top:10px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_endpoints }}</h3></div>
        <div class="panel-body">
          <p><strong>{{ text_status_url }}</strong><br><code id="aneepay-status-url">{{ status_url }}</code>
            <button type="button" class="btn btn-xs btn-default aneepay-copy" data-target="aneepay-status-url">{{ text_copy }}</button></p>
          <p><strong>{{ text_success_url }}</strong><br><code id="aneepay-success-url">{{ success_url }}</code>
            <button type="button" class="btn btn-xs btn-default aneepay-copy" data-target="aneepay-success-url">{{ text_copy }}</button></p>
          <p><strong>{{ text_fail_url }}</strong><br><code id="aneepay-fail-url">{{ fail_url }}</code>
            <button type="button" class="btn btn-xs btn-default aneepay-copy" data-target="aneepay-fail-url">{{ text_copy }}</button></p>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">{{ text_example }}</h3></div>
        <div class="panel-body">{{ conversion_example }}</div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript">
(function () {
	function esc(s) { return String(s == null ? '' : s); }

	// Test connection
	var btn = document.getElementById('aneepay-test-connection');
	var out = document.getElementById('aneepay-test-result');
	if (btn) {
		btn.addEventListener('click', function () {
			btn.disabled = true;
			out.textContent = '{{ text_checking }}';
			fetch(btn.getAttribute('data-url')).then(function (r) { return r.json(); }).then(function (d) {
				btn.disabled = false;
				if (d && d.ok) {
					out.textContent = d.message || '{{ text_connected }}';
					out.style.color = 'green';
				} else {
					out.textContent = (d && d.message) || '{{ text_failed }}';
					out.style.color = 'red';
				}
			}).catch(function () {
				btn.disabled = false;
				out.textContent = '{{ text_failed }}';
				out.style.color = 'red';
			});
		});
	}

	// Request log
	var toggle = document.getElementById('aneepay-toggle-logs');
	var panel = document.getElementById('aneepay-log-panel');
	var clear = document.getElementById('aneepay-clear-logs');
	var count = document.getElementById('aneepay-log-count');
	if (toggle && panel) {
		var loaded = false;
		function renderLogs(logs) {
			count.textContent = logs.length ? ('— ' + logs.length + ' requests') : '';
			clear.style.display = logs.length ? 'inline-block' : 'none';
			if (!logs.length) {
				panel.innerHTML = '<p>{{ text_no_logs }}</p>';
				return;
			}
			var table = document.createElement('table');
			table.className = 'table table-condensed table-bordered';
			table.innerHTML = '<thead><tr><th>Time</th><th>Method</th><th>Endpoint</th><th>Code</th><th>Latency</th><th>Body</th></tr></thead>';
			var tbody = document.createElement('tbody');
			logs.forEach(function (l) {
				var m = {};
				try { m = (l.message ? JSON.parse(l.message) : {}); } catch (e) { m = {}; }
				var tr = document.createElement('tr');
				tr.innerHTML = '<td>' + esc(l.date_added) + '</td><td>' + esc(m.method) + '</td>' +
					'<td>' + esc(m.endpoint) + '</td>' +
					'<td>' + esc(m.code) + '</td>' +
					'<td>' + esc(m.latency != null ? m.latency + ' ms' : '') + '</td>' +
					'<td><small>' + esc(m.body) + '</small></td>';
				tbody.appendChild(tr);
			});
			table.appendChild(tbody);
			panel.innerHTML = '';
			panel.appendChild(table);
		}
		toggle.addEventListener('click', function () {
			var visible = panel.style.display !== 'none';
			if (visible) {
				panel.style.display = 'none';
			} else {
				panel.style.display = 'block';
				if (!loaded) {
					loaded = true;
					fetch(toggle.getAttribute('data-url')).then(function (r) { return r.json(); }).then(function (d) {
						if (d && d.ok) { renderLogs(d.logs || []); }
					});
				}
			}
		});
		if (clear) {
			clear.addEventListener('click', function () {
				fetch(clear.getAttribute('data-url')).then(function (r) { return r.json(); }).then(function () {
					loaded = false;
					fetch(toggle.getAttribute('data-url')).then(function (r) { return r.json(); })
						.then(function (d) { if (d && d.ok) { renderLogs(d.logs || []); } });
				});
			});
		}
	}

	// Copy endpoints
	document.querySelectorAll('.aneepay-copy').forEach(function (b) {
		b.addEventListener('click', function () {
			var id = b.getAttribute('data-target');
			var el = document.getElementById(id);
			if (el && navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(el.textContent);
				b.textContent = '{{ text_copied }}';
				setTimeout(function () { b.textContent = '{{ text_copy }}'; }, 1500);
			}
		});
	});
})();
</script>
{{ footer }}
